# Same app with live segmentation of uploaded scans (needs a GPU and the NV-Segment-CT weights mounted at /models/model.pt; NOT baked in: size, and NVIDIA's licence terms).
# NOT built or run in this repository's development environment; the pinned versions (torch 2.14.1 + CUDA 13.0, MONAI 1.6.1) were validated on an A100 outside a container.
#   docker build -f Dockerfile.gpu -t glassbox-ct-gpu .
#   docker run --rm --gpus all -p 8000:8000 -v /path/to/model.pt:/models/model.pt --env-file .env glassbox-ct-gpu
# syntax=docker/dockerfile:1
FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
COPY requirements-app.txt .
RUN pip install -r requirements-app.txt
COPY LICENSE ./LICENSE
COPY glassbox ./glassbox
COPY --from=web /web/dist ./frontend/dist
ARG DEMO_DATA_URL=https://github.com/Mokhan02/Glass-Box-CT/releases/download/v2/glassbox-demo-data-v2.tar.gz
ARG DEMO_DATA_SHA256=dccf71fab9465f4dadecfb32bace4cc776f4f3bb8c486e281b42053b3665fd21
COPY scripts/fetch_demo_data.py /tmp/fetch_demo_data.py
RUN python /tmp/fetch_demo_data.py --url "$DEMO_DATA_URL" --sha256 "$DEMO_DATA_SHA256" --out /app && rm /tmp/fetch_demo_data.py
ENV GLASSBOX_DEMO_DIR=/app/demo GLASSBOX_FRONTEND_DIST=/app/frontend/dist GLASSBOX_WEIGHTS=/models/model.pt GLASSBOX_LIVE=1 GLASSBOX_ENV=production
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn --factory glassbox.app.main:build_app --host 0.0.0.0 --port ${PORT:-8000}"]
