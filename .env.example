# Copy to .env (git-ignored) and fill in. The agent only ever reads these variables, so switching provider is a config change.
#
# Development: NVIDIA's hosted API (build.nvidia.com, free tier).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
# Reasoning model writes the final report; the fast model runs the tool-calling steps. Use model IDs your provider lists.
LLM_MODEL=
LLM_FAST_MODEL=
#
# Submission: Nebius Token Factory (OpenAI-compatible). Copy the base URL and model IDs from the Token Factory console.
# The submitted build MUST call Token Factory at runtime (hackathon rule), so set these before the final demo and video.
# LLM_BASE_URL=<Token Factory base URL from the Nebius console>
