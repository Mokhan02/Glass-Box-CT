# Copy to .env (git-ignored) and fill in. Production uses Nebius Token Factory ONLY (docs/TOKEN_FACTORY.md).
#
# Submission / production: Nebius Token Factory. LLM_BASE_URL is not needed (it defaults to https://api.tokenfactory.nebius.com/v1/).
NEBIUS_API_KEY=
# Reasoning model writes the report and Ask answers; the fast model runs the tool-calling steps. Use IDs from `python scripts/list_models.py`.
LLM_MODEL=
LLM_FAST_MODEL=
#
# Development only (leave GLASSBOX_ENV unset): any OpenAI-compatible endpoint instead, for example NVIDIA's hosted API.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=
